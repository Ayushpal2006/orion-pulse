# ==============================================================================
# Apka Bill (Orion POS) — Backend Environment Template (Internal & External)
# ==============================================================================
# Copy this file to `backend/.env` for local development (never commit secrets).
#
# ------------------------------------------------------------------------------
# RUN & DATABASE COMMANDS (run from /Users/ayush/Code/ApkaBill/orion-pulse)
# ------------------------------------------------------------------------------
# ONE COMMAND (Auto-starts Postgres + Backend :8080 + Frontend :8081):
#   npm run dev
#
# Built Backend Start (Auto-starts Postgres + compiled backend):
#   npm start
#
# Other Commands:
#   Push Schema / Drizzle Studio:   cd backend && npx drizzle-kit push && npx drizzle-kit studio
#   Build Backend:                  npm run build:backend
#   Run Tests:                      bun test frontend/src/lib/__tests__/invoice-share.test.ts frontend/src/lib/__tests__/offline-sync-payload.test.ts backend/src/tests/share-service-whatsapp.test.ts backend/src/tests/worker-jwt-env.test.ts
#   Cloudflare Worker Local Dev:    cd backend && npm run worker:dev
#
# ------------------------------------------------------------------------------
# DEV LOGIN CREDENTIALS (Local Dev / Seeded DB)
# ------------------------------------------------------------------------------
# Org Admin ID / Email:  admin@orion.com
# Org Admin Password:    admin123
# Super Admin IDs:       superadmin@apkabill.com  (or superadmin@orion.com / superadmin)
# Super Admin Password:  SuperAdmin@123           (active in dev when SUPER_ADMIN_PASSWORD unset)
#
# ==============================================================================
# 1. INTERNAL ENV (Local Machine PostgreSQL + Local Disk Storage + Auth)
# ==============================================================================
PORT=8080
NODE_ENV=development

# PostgreSQL Database (Required: must start with postgres:// or postgresql://)
DB_TYPE=postgres
DATABASE_PROVIDER=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orion
BASE_URL=http://localhost:8080

# CORS Origins: Vite dev (:8081), alt dev (:3000/:5173), and Capacitor Android origins
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000,http://localhost:5173,capacitor://localhost,http://localhost,https://localhost
TRUST_PROXY=1

JWT_SECRET=orion-pos-secret-key-change-in-prod
JWT_EXPIRES_IN=24h

ADMIN_EMAIL=admin@orion.com
ADMIN_PASSWORD=admin123
# SUPER_ADMIN_EMAIL=superadmin@orion.com
# SUPER_ADMIN_PASSWORD=SuperAdmin@123

# ==============================================================================
# 2. EXTERNAL ENV (Neon Cloud PostgreSQL / Cloudflare Hyperdrive / Workers)
# Never commit real production secrets here — configure them in Worker Secrets or ignored `.env`.
# ==============================================================================
# NODE_ENV=production
# DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/DB?sslmode=require
# HYPERDRIVE_URL=                       # Automatically injected by Cloudflare Workers HYPERDRIVE binding (wrangler.toml)
# BASE_URL=https://orion-pos-api.ayushpalworkplace2006.workers.dev
# ALLOWED_ORIGINS=https://your-frontend-domain.com,capacitor://localhost,http://localhost,https://localhost
# JWT_SECRET=replace-with-random-64-char-hex-secret
# SUPER_ADMIN_EMAIL=superadmin@orion.com
# SUPER_ADMIN_PASSWORD=replace-with-strong-super-admin-password

# ==============================================================================
# 3. MEDIA & FILE STORAGE (Internal Local Disk vs External Cloudinary)
# ==============================================================================
# Internal Local Dev (default when empty):
#   Product images & temp PDFs save to local disk: backend/uploads/products & backend/uploads/invoices
# External Cloud / Production (required on Cloudflare Workers since filesystem is ephemeral):
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==============================================================================
# 4. GOOGLE WORKSPACE OAUTH & SHEETS BACKUP (Optional External Integrations)
# ==============================================================================
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=your-secure-32-byte-hex-or-phrase

GOOGLE_SYNC_ENABLED=0
GOOGLE_SHEET_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
