{
  "name": "orion-pulse",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=tanstack_start_ts",
    "dev": "node scripts/run-local.mjs dev",
    "dev:backend": "node scripts/run-local.mjs dev:backend",
    "dev:frontend": "npm run dev --workspace=tanstack_start_ts",
    "start": "node scripts/run-local.mjs start"
  },
  "dependencies": {
    "typescript": "^5.9.3"
  }
}


